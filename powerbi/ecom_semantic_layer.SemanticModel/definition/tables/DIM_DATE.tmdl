	column 'Is Complete Month'
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: c0d9ca72-e7e4-4fba-a3cd-a4cf7ce2d567
		summarizeBy: none
		isNameInferred
		sourceColumn: [Is Complete Month]

		annotation SummarizationSetBy = Automatic

	partition DIM_DATE = calculated
		mode: import
		source =

				VAR _MinDate = MIN ( MIN ( FCT_ORDERS[ORDER_DATE] ), MIN ( DIM_CUSTOMERS[SIGNUP_DATE] ) )
				VAR _MaxDate = MAX ( FCT_ORDERS[ORDER_DATE] )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( DATE ( YEAR ( _MinDate ), 1, 1 ), DATE ( YEAR ( _MaxDate ), 12, 31 ) ),
				    "Year",              YEAR ( [Date] ),
				    "Quarter",           "Q" & QUARTER ( [Date] ),
				    "Month Number",      MONTH ( [Date] ),
				    "Month",             FORMAT ( [Date], "MMM" ),
				    "Year Month",        FORMAT ( [Date], "YYYY-MM" ),
				    "Year Month Key",    YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "Weekday",           FORMAT ( [Date], "ddd" ),
				    "Is Complete Month", [Date] < DATE ( YEAR ( TODAY () ), MONTH ( TODAY () ), 1 )
				)

	annotation PBI_Id = f6d34329770d44948ebbafcb818b3550
